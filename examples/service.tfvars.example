# Variables for a service workspace (one per app).
client               = "sayer"
app                  = "webapi"
environment          = "dev"
# Region is fixed to us-east-1 in the stack's provider — not a variable.
aws_account_id       = "111111111111" # guardrail: plan fails on a credential from another account

tfc_organization     = "REPLACE_ORG"
foundation_workspace = "sayer-dev-foundation"

# ECR repo (sayer-webapi-dev) is created by the foundation stack; the URI is composed
# from foundation's ecr_repository_urls[app] + this version. Bump to promote a release.
# Injected as env vars: APP_VERSION = this value, APP_VERSION_DATE = auto-stamped when it changes.
image_version  = "1.0.0"
container_port = "8080"
health_path    = "/health"
subdomain      = "api.sayer.ecolors.app"

# Databases this app connects to (all live on the client-env's shared RDS in foundation).
# Each becomes ConnectionStrings__<key>. Exactly one migrate=true = this app's own db (the one
# EF Core migrates); the rest are use-only (migrated by their owning app).
connections = [
  { key = "Licensee", db_name = "sayer", migrate = true },
  # Cross-env shared db (another client-env / account): set `source` to its foundation workspace.
  # { key = "Admin", db_name = "EColorsAdminProd", source = "ecolors-prod-foundation" },
]

# App config (.NET Key__Child) — plaintext, overrides appsettings.json. Set by the factory
# from each app's `settings`.
runtime_env = {
  "ASPNETCORE_ENVIRONMENT"         = "Production"
  "Serilog__MinimumLevel__Default" = "Information"
}

# Names of secret env vars (set by the factory from `secret_settings`).
secret_settings = ["Jwt__SigningKey"]
# Their VALUES — set this as a SENSITIVE variable on the workspace, never commit real secrets:
# secret_values = { "Jwt__SigningKey" = "..." }

github_repo = "CodeQuality-Uyu/sayer-web-api"

# Optional blobs (multimedia: product images via CDN, downloadable Excels, ...).
# Normally you don't set these by hand — the factory derives them from the backend's `blobs`
# block in clients.auto.tfvars. Shown here for a standalone service workspace.
create_blobs = false
# blobs_bucket_name      = "sayer-webapi-prod-blobs"     # default {client}-{app}-{env}-blobs
# blobs_domain           = "assets.sayer.ecolors.app"    # CDN domain, under the client-env zone
# blobs_allowed_origins  = ["https://sayer.ecolors.app"] # who may presigned-PUT (usually the SPA)
# blobs_temporary_object = "temporary"                   # must match the app's Blob:TemporaryObject
# The app also receives Blob__BucketName / Blob__CloudFrontDomain / Blob__TemporaryObject /
# AWS__Region automatically, and the instance role gets S3 R/W on the bucket.
